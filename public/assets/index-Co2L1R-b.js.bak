                    className:"w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-amber-300 font-bold text-xs",
                    children:"ت"
                  }),
                  r.jsxs("div",{
                    children:[
                      r.jsx("h3",{
                        className:"font-extrabold text-sm sm:text-base",
