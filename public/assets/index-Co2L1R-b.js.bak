    const tm=window.setInterval(()=>setCooldown(v=>Math.max(0,v-1)),1000);
    return()=>window.clearInterval(tm);
  },[cooldown]);

  if(!s)return null;

  const normalizePhone=(val)=>{
    let d=(val||"").replace(/\D/g,"");
    if(d.startsWith("00"))d=d.slice(2);
    if(d.startsWith("0"))d="967"+d.slice(1);
    if(d.length===9&&d.startsWith("7"))d="967"+d;
    return d;
  };

  const handleSendOtp=async(ev)=>{
    if(ev&&ev.preventDefault)ev.preventDefault();
    const clean=normalizePhone(phone);
    if(!clean||clean.length<8){
      a("يرجى إدخال رقم هاتف صحيح (مثال: 771234567)","info");
      return;
    }
    setIsBusy(!0);
    try{
      const res=await fetch("/takhfid/api/v2/auth/send-otp",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({phoneNumber:clean})
      });
      const data=await res.json().catch(()=>({}));
      if(!res.ok||data.success===!1){
        throw new Error(data.error||data.message||"تعذر إرسال كود التحقق");
      }
      setPhone(clean);
      setStep("otp");
      setCooldown(data.retryAfterSeconds||60);
      a("تم إرسال كود التحقق عبر واتساب بنجاح 📲","success");
    }catch(err){
      console.error("sendOtp error:",err);
      a(err.message||"تعذر إرسال كود التحقق، يرجى المحاولة مرة أخرى","info");
    }finally{
      setIsBusy(!1);
    }
  };

  const handleVerifyOtp=async(ev)=>{
    if(ev&&ev.preventDefault)ev.preventDefault();
