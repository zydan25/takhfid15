    { id: "icon-coffee", label: "مروّق وراقي", val: "☕", bg: "from-amber-800 to-stone-800" },
    { id: "icon-trophy", label: "عميل متميز", val: "🏆", bg: "from-yellow-500 to-amber-600" },
    { id: "icon-sparkles", label: "بريق وأناقة", val: "✨", bg: "from-purple-600 to-pink-600" }
  ];

  // Save selected avatar
  const handleSelectAvatarPreset = (preset) => {
    const avatarVal = preset.val;
    setCurrentAvatar(avatarVal);
    setSelectedPresetId(preset.id);
    if (window.__saveUserAvatar) {
      window.__saveUserAvatar(phone, avatarVal);
    }
    setIsAvatarModalOpen(false);
    A && A("تم تغيير أيقونة صورة الحساب بنجاح ✨", "success");
  };

  // Custom Image Upload handler (Base64)
  const handleImageUpload = (event) => {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) {
      A && A("يرجى اختيار صورة حجمها أقل من 2 ميجابايت", "error");
      return;
    }
    const reader = new FileReader();
    reader.onload = (eLoad) => {
      const base64Url = eLoad.target.result;
      setCurrentAvatar(base64Url);
      if (window.__saveUserAvatar) {
        window.__saveUserAvatar(phone, base64Url);
      }
      setIsAvatarModalOpen(false);
      A && A("تم تحديث صورة الحساب الشخصية بنجاح 🖼️✨", "success");
    };
    reader.readAsDataURL(file);
  };

  // Reset Avatar to initials
  const handleResetAvatar = () => {
    setCurrentAvatar("");
    if (window.__saveUserAvatar) {
      window.__saveUserAvatar(phone, "");
