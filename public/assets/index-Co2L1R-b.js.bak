  const [showTempConfirmPass, setShowTempConfirmPass] = S.useState(false);
  const [generatedTempCode, setGeneratedTempCode] = S.useState("");
  const [isSubmitting, setIsSubmitting] = S.useState(false);

  // Avatar Customization States
  const phone = (u && u.phone) || "";
  const initialAvatar = (window.__getUserAvatar && window.__getUserAvatar(phone, u && u.avatar)) || (u && u.avatar) || "";
  const [currentAvatar, setCurrentAvatar] = S.useState(initialAvatar);
  const [isAvatarModalOpen, setIsAvatarModalOpen] = S.useState(false);
  const [selectedPresetId, setSelectedPresetId] = S.useState("");

  // Presets of avatars/icons
  const AVATAR_PRESETS = [
    { id: "icon-user", label: "أنيق كلاسيكي", val: "👤", bg: "from-slate-900 to-slate-700" },
    { id: "icon-crown", label: "تاج الفخامة", val: "👑", bg: "from-amber-500 to-amber-700" },
    { id: "icon-star", label: "عميل نجم", val: "⭐", bg: "from-amber-400 to-orange-500" },
    { id: "icon-gem", label: "جوهرة VIP", val: "💎", bg: "from-cyan-500 to-blue-600" },
