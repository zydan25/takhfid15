      a("كود التحقق يجب أن يتكون من 6 أرقام","info");
      return;
    }
    setIsBusy(!0);
    try{
      const clean=normalizePhone(phone);
      const res=await fetch("/takhfid/api/v2/auth/verify-otp",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          phoneNumber:clean,
