      }
    }catch(err){
      console.error("verifyOtp error:",err);
      a(err.message||"رمز التحقق غير صحيح أو انتهت صلاحيته","info");
    }finally{
      setIsBusy(!1);
    }
  };

  return r.jsxs("div",{
