window.__DEFAULT_INQUIRIES = [
  {
    id: "inq-shipping",
    label: "موعد الشحن والتوصيل",
    question: "السلام عليكم، متى موعد توصيل وشحن الطلب بعد إتمام الدفع؟",
    answer: "مدة التوصيل والشحن تستغرق من 24 إلى 48 ساعة كحد أقصى بعد تأكيد التحويل. ويتم تسليمكم رقم بوليصة الشحن فور إرسال الشحنة 🚚📦.",
    enabled: true
  },
  {
    id: "inq-payment",
    label: "خيارات الدفع المتاحة",
    question: "مرحباً، أريد معرفة وتأكيد خيارات ووسائل الدفع المتاحة لسداد قيمة السلة",
    answer: "وسائل الدفع المعتمدة متوفرة في زر \"بيانات الدفع\" بالأعلى، وتشمل: حساب كريمي (3052037319 باسم بشير نجيب التبالي)، محفظة فلوسك (701703)، وحساب مشترك لكافة المحافظ الإلكترونية برقم الهاتف (771053370 باسم بشير نجيب ناجي التبالي) بالإضافة إلى محفظة جيب ونقطة حاسب كريمي 💳.",
    enabled: true
  },
  {
    id: "inq-tracking",
    label: "متابعة الطلب بعد الحوالة",
    question: "كيف أتابع حالة طلبي بعد إرسال إشعار التحويل؟",
    answer: "بمجرد إرسالك صورة إشعار التحويل، سيقوم مسؤول خدمة العملاء بتأكيد الدفع وتحديث حالة طلبك إلى \"تم قبول الطلب وجاري الشحن\" مباشرة داخل هذه المحادثة ✨.",
    enabled: true
  },
  {
    id: "inq-sizing",
    label: "الاستبدال والمقاسات",
    question: "هل يتوفر استبدال أو تعديل للمقاسات في حال لم يناسبني المقاس؟",
    answer: "نعم، يتوفر استبدال مجاني للمقاسات خلال 3 أيام من استلام الطلب بشرط أن يكون المنتج بحالته الأصلية وغلافه 👗👌.",
    enabled: true
  },
  {
    id: "inq-support",
    label: "التواصل مع المبيعات",
    question: "أرغب بالتواصل المباشر مع مسؤول المبيعات للاستفسار عن تفاصيل طلبي",
    answer: "مرحباً بك! مسؤول خدمة العملاء والمبيعات يتابع رسائلك مباشرة الآن وسيقوم بالرد على استفساراتك فوراً 💬.",
    enabled: true
  },
  {
    id: "inq-availability",
    label: "جاهزية السلة والشحن",
    question: "هل المنتجات في السلة جاهزة للشحن الفوري؟",
    answer: "نعم، كافة المنتجات المعروضة في سلتكم متوفرة حالياً في مستودعاتنا وجاهزة للتجهيز والشحن الفوري بمجرد إتمام الدفع ✅.",
    enabled: true
  }
];

window.__getChatInquiries = function() {
  try {
    const rawV3 = localStorage.getItem("customer_chat_inquiries_v3");
    if (rawV3) {
      const parsed = JSON.parse(rawV3);
      if (Array.isArray(parsed) && parsed.length > 0) return parsed;
    }
    const rawV2 = localStorage.getItem("customer_chat_inquiries_v2");
    if (rawV2) {
      let parsed = JSON.parse(rawV2);
      if (Array.isArray(parsed) && parsed.length > 0) {
        parsed = parsed.map(item => {
          if (item.id === "inq-payment" || (item.question && item.question.includes("الدفع"))) {
            return {
              ...item,
              answer: "وسائل الدفع المعتمدة متوفرة في زر \"بيانات الدفع\" بالأعلى، وتشمل: حساب كريمي (3052037319 باسم بشير نجيب التبالي)، محفظة فلوسك (701703)، وحساب مشترك لكافة المحافظ الإلكترونية برقم الهاتف (771053370 باسم بشير نجيب ناجي التبالي) بالإضافة إلى محفظة جيب ونقطة حاسب كريمي 💳."
            };
          }
          return item;
        });
        localStorage.setItem("customer_chat_inquiries_v3", JSON.stringify(parsed));
        return parsed;
      }
    }
  } catch(e) {}
  return window.__DEFAULT_INQUIRIES;
};

window.__saveChatInquiries = function(items) {
  try {
    localStorage.setItem("customer_chat_inquiries_v3", JSON.stringify(items));
    localStorage.setItem("customer_chat_inquiries_v2", JSON.stringify(items));
    window.dispatchEvent(new CustomEvent("customer_chat_inquiries_changed", { detail: items }));
  } catch(e) {}
};

const ChatInquiriesAdminModal = ({ isOpen: s, onClose: e, onShowToast: t }) => {
  const [inqs, setInqs] = S.useState(() => window.__getChatInquiries());
  const [editingId, setEditingId] = S.useState(null);
  const [editForm, setEditForm] = S.useState({ label: "", question: "", answer: "" });
  const [isAdding, setIsAdding] = S.useState(false);
  const [newForm, setNewForm] = S.useState({ label: "", question: "", answer: "" });

  S.useEffect(() => {
    if (s) {
      setInqs(window.__getChatInquiries());
      setEditingId(null);
      setIsAdding(false);
    }
  }, [s]);

  if (!s) return null;

  const handleToggle = (id) => {
    const next = inqs.map(item => item.id === id ? { ...item, enabled: item.enabled === false ? true : false } : item);
    setInqs(next);
    window.__saveChatInquiries(next);
    t && t("تم تحديث حالة الاستفسار ✅", "info");
  };

  const handleDelete = (id) => {
    if (inqs.length <= 1) {
      t && t("يجب الإبقاء على استفسار واحد على الأقل", "error");
      return;
    }
    const next = inqs.filter(item => item.id !== id);
    setInqs(next);
    window.__saveChatInquiries(next);
    t && t("تم حذف الاستفسار بنجاح 🗑️", "success");
  };

  const startEdit = (item) => {
    setEditingId(item.id);
    setEditForm({ label: item.label, question: item.question, answer: item.answer });
    setIsAdding(false);
  };

  const saveEdit = (id) => {
    if (!editForm.label.trim() || !editForm.question.trim() || !editForm.answer.trim()) {
      t && t("يرجى ملء كافة الحقول", "error");
      return;
    }
    const next = inqs.map(item => item.id === id ? { ...item, label: editForm.label.trim(), question: editForm.question.trim(), answer: editForm.answer.trim() } : item);
    setInqs(next);
    window.__saveChatInquiries(next);
    setEditingId(null);
    t && t("تم حفظ التعديل بنجاح ✨", "success");
  };

  const saveNew = () => {
    if (!newForm.label.trim() || !newForm.question.trim() || !newForm.answer.trim()) {
      t && t("يرجى ملء كافة الحقول لإضافة الاستفسار", "error");
      return;
    }
    const newItem = {
      id: `inq-${Date.now()}`,
      label: newForm.label.trim(),
      question: newForm.question.trim(),
      answer: newForm.answer.trim(),
      enabled: true
    };
    const next = [...inqs, newItem];
    setInqs(next);
    window.__saveChatInquiries(next);
    setIsAdding(false);
    setNewForm({ label: "", question: "", answer: "" });
    t && t("تمت إضافة الاستفسار والرد بنجاح ➕", "success");
  };

  const resetDefaults = () => {
    setInqs(window.__DEFAULT_INQUIRIES);
    window.__saveChatInquiries(window.__DEFAULT_INQUIRIES);
    setEditingId(null);
    setIsAdding(false);
    t && t("تمت استعادة الردود والاستفسارات الافتراضية 🔄", "info");
  };

  return r.jsxs("div", {
    className: "fixed inset-0 z-[120] bg-black/80 backdrop-blur-xs flex items-center justify-center p-2.5 sm:p-4 animate-fadeIn font-['Cairo',sans-serif]",
    onClick: e,
    children: [
      r.jsxs("div", {
        className: "bg-white w-full max-w-2xl rounded-3xl shadow-2xl flex flex-col max-h-[92vh] overflow-hidden border border-slate-200 animate-slideUp",
        onClick: evt => evt.stopPropagation(),
        children: [
          r.jsxs("div", {
            className: "bg-slate-900 text-white px-4 sm:px-5 py-3 flex items-center justify-between shrink-0 shadow-md",
            children: [
              r.jsxs("div", {
                className: "flex items-center gap-2.5",
                children: [
                  r.jsx("div", {
                    className: "w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-amber-400 text-slate-950 flex items-center justify-center font-black",
                    children: r.jsx(vM, { className: "w-4 h-4 sm:w-5 sm:h-5 text-slate-950" })
                  }),
                  r.jsxs("div", {
                    children: [
                      r.jsx("h3", { className: "text-xs sm:text-sm font-black text-white", children: "إدارة استفسارات وردود المحادثة التلقائية" }),
                      r.jsx("p", { className: "text-[10px] sm:text-[11px] text-slate-400", children: "التحكم في أزرار الاستفسارات وتعديل الردود التلقائية المقترنة بها في محادثة العملاء" })
                    ]
                  })
                ]
              }),
              r.jsx("button", {
                type: "button",
                onClick: e,
                className: "p-1.5 rounded-lg hover:bg-white/10 text-slate-400 hover:text-white transition-colors cursor-pointer",
                children: r.jsx(js, { className: "w-5 h-5" })
              })
            ]
          }),
          r.jsxs("div", {
            className: "p-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2 shrink-0 flex-wrap",
            children: [
              r.jsxs("button", {
                type: "button",
                onClick: () => { setIsAdding(true); setEditingId(null); },
                className: "px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-black flex items-center gap-1.5 shadow cursor-pointer active:scale-95 transition-all",
                children: [r.jsx("span", { children: "➕ إضافة استفسار ورد جديد" })]
              }),
              r.jsxs("button", {
                type: "button",
                onClick: resetDefaults,
                className: "px-3 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 text-xs font-bold flex items-center gap-1 cursor-pointer transition-all active:scale-95",
                children: [r.jsx("span", { children: "استعادة الافتراضيات 🔄" })]
              })
            ]
          }),
          isAdding && r.jsxs("div", {
            className: "p-4 bg-amber-50/70 border-b border-amber-200 space-y-2.5 animate-fadeIn shrink-0",
            children: [
              r.jsx("h4", { className: "text-xs font-black text-amber-950 flex items-center gap-1.5", children: "➕ إضافة استفسار ورد جديد بالمحادثة:" }),
              r.jsxs("div", {
                className: "grid grid-cols-1 sm:grid-cols-2 gap-2",
                children: [
                  r.jsxs("div", {
                    children: [
                      r.jsx("label", { className: "text-[11px] font-bold text-slate-700 block mb-1", children: "عنوان الزر بالمحادثة (مختصر):" }),
                      r.jsx("input", {
                        type: "text",
                        value: newForm.label,
                        onChange: evt => setNewForm({ ...newForm, label: evt.target.value }),
                        placeholder: "مثال: موعد الشحن والتوصيل",
                        className: "w-full bg-white border border-slate-300 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800 focus:outline-hidden focus:ring-1 focus:ring-slate-900"
                      })
                    ]
                  }),
