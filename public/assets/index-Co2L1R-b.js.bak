/* === USER AVATAR CUSTOMIZATION & SYNC SYSTEM === */
if (typeof window !== "undefined") {
  window.__getUserAvatar = function(phone, fallback) {
    try {
      if (phone) {
        var cp = window.__cleanPhone ? window.__cleanPhone(phone) : phone;
        var map = JSON.parse(localStorage.getItem("app_user_avatars") || "{}");
        if (map[cp]) return map[cp];
      }
      var prof = JSON.parse(localStorage.getItem("user_profile") || "null");
      if (prof && prof.avatar) return prof.avatar;
    } catch(e) {}
    return fallback || null;
  };

  window.__saveUserAvatar = function(phone, avatarData) {
    try {
      if (phone) {
        var cp = window.__cleanPhone ? window.__cleanPhone(phone) : phone;
        var map = JSON.parse(localStorage.getItem("app_user_avatars") || "{}");
        map[cp] = avatarData;
        localStorage.setItem("app_user_avatars", JSON.stringify(map));
      }
      var prof = JSON.parse(localStorage.getItem("user_profile") || "null");
      if (prof) {
        prof.avatar = avatarData;
        localStorage.setItem("user_profile", JSON.stringify(prof));
      }
      window.dispatchEvent(new CustomEvent("profile-updated", { detail: { avatar: avatarData } }));
      return true;
    } catch(e) {
      return false;
    }
  };
}

/* === USER PASSWORD & AUTH SECURITY HELPERS === */
if (typeof window !== "undefined") {
  window.__cleanPhone = function(p) {
    if (!p) return "";
    return String(p).replace(/[\s\-\+\(\)]/g, "").replace(/^967/, "").replace(/^0/, "");
  };

  window.__getUserPassword = function(phone) {
    if (!phone) return null;
    try {
      var cp = window.__cleanPhone(phone);
      var map = JSON.parse(localStorage.getItem("app_user_passwords") || "{}");
      return map[cp] || null;
    } catch(e) {
      return null;
    }
  };

  window.__saveUserPassword = function(phone, pass) {
    if (!phone || !pass) return false;
    try {
      var cp = window.__cleanPhone(phone);
      var map = JSON.parse(localStorage.getItem("app_user_passwords") || "{}");
      map[cp] = String(pass);
      localStorage.setItem("app_user_passwords", JSON.stringify(map));
      return true;
    } catch(e) {
      return false;
    }
  };

  window.__sendTempPassword = function(phone) {
    if (!phone) return { success: false, message: "رقم الهاتف غير متوفر" };
    var cp = window.__cleanPhone(phone);
    var code = Math.floor(100000 + Math.random() * 900000).toString();
    try {
      var tempMap = JSON.parse(localStorage.getItem("app_temp_passwords") || "{}");
      tempMap[cp] = {
        code: code,
        createdAt: Date.now(),
        expiresAt: Date.now() + 10 * 60 * 1000
      };
      localStorage.setItem("app_temp_passwords", JSON.stringify(tempMap));
      return { success: true, code: code, message: "تم إرسال رمز المرور المؤقت بنجاح" };
    } catch(e) {
      return { success: false, message: "حدث خطأ أثناء إنشاء الرمز المؤقت" };
    }
  };

  window.__verifyTempPassword = function(phone, code) {
    if (!phone || !code) return { success: false, message: "يرجى إدخال الرمز" };
    var cp = window.__cleanPhone(phone);
    try {
      var tempMap = JSON.parse(localStorage.getItem("app_temp_passwords") || "{}");
      var rec = tempMap[cp];
      if (!rec) return { success: false, message: "لم يتم طلب رمز مؤقت لهذا الرقم أو انتهت صلاحيته" };
      if (Date.now() > rec.expiresAt) return { success: false, message: "عذراً، لقد انتهت صلاحية هذا الرمز (10 دقائق)" };
      if (String(rec.code).trim() !== String(code).trim()) return { success: false, message: "رمز المرور المؤقت غير صحيح" };
      return { success: true };
    } catch(e) {
      return { success: false, message: "حدث خطأ أثناء التحقق من الرمز" };
    }
  };
}



/* === ADVANCED ACCOUNT MANAGEMENT VIEW (إدارة حسابي مع تخصيص الصورة/الأيقونة) === */
