                        r.jsx("p", { className: "text-xs font-black text-slate-900 truncate", children: displayName }),
                        r.jsx("p", { className: "text-[11px] text-slate-500 mt-0.5", children: "الأيقونة المحددة تظهر فوراً في ملفك الشخصي" })
                      ]
                    })
                  ]
                }),

                /* Section 1: Presets Grid */
                r.jsxs("div", {
                  className: "space-y-2",
                  children: [
                    r.jsx("h4", { className: "text-xs font-bold text-slate-700", children: "أيقونات ورموز جاهزة مميزة:" }),
                    r.jsx("div", {
                      className: "grid grid-cols-4 gap-2.5",
                      children: AVATAR_PRESETS.map((preset) => {
                        const isSelected = currentAvatar === preset.val || selectedPresetId === preset.id;
                        return r.jsxs("button", {
                          key: preset.id,
                          type: "button",
                          onClick: () => handleSelectAvatarPreset(preset),
                          className: `flex flex-col items-center justify-center p-2.5 rounded-2xl border transition-all cursor-pointer ${
                            isSelected
                              ? "bg-amber-50 border-amber-500 shadow-xs ring-2 ring-amber-400"
                              : "bg-white border-slate-200 hover:border-slate-300 hover:bg-slate-50"
                          }`,
                          children: [
                            r.jsx("div", {
                              className: `w-11 h-11 rounded-xl bg-gradient-to-tr ${preset.bg} text-white flex items-center justify-center text-xl shadow-xs mb-1.5`,
                              children: preset.val
                            }),
                            r.jsx("span", {
                              className: "text-[10px] font-bold text-slate-700 truncate max-w-full",
                              children: preset.label
                            })
                          ]
                        });
                      })
                    })
                  ]
                }),

                /* Section 2: Upload Custom Photo */
                r.jsxs("div", {
                  className: "pt-2 border-t border-slate-100 space-y-2",
                  children: [
                    r.jsx("h4", { className: "text-xs font-bold text-slate-700", children: "أو رفع صورة شخصية من جهازك:" }),
                    r.jsxs("label", {
                      className: "w-full border-2 border-dashed border-slate-200 hover:border-slate-900 rounded-2xl p-3 flex items-center justify-center gap-2 cursor-pointer bg-slate-50/60 hover:bg-slate-50 transition-colors text-slate-700 font-bold text-xs",
                      children: [
                        r.jsx("span", { className: "text-base", children: "📸" }),
                        r.jsx("span", { children: "اختيار صورة من المعرض أو الكاميرا" }),
                        r.jsx("input", {
                          type: "file",
                          accept: "image/*",
                          onChange: handleImageUpload,
                          className: "hidden"
                        })
                      ]
                    })
                  ]
                }),

                /* Section 3: Reset Button */
                currentAvatar && r.jsxs("button", {
                  type: "button",
                  onClick: handleResetAvatar,
                  className: "w-full py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 text-xs font-bold transition-colors cursor-pointer flex items-center justify-center gap-1.5",
                  children: [
                    r.jsx("span", { children: "↺" }),
                    r.jsx("span", { children: "استعادة الأيقونة الافتراضية الأولية" })
                  ]
                })
              ]
            })
          ]
        })
      ) : null
    ]
  });
};

/* === COMPLETE PERKS, GIFTS & CUSTOMER WALLETS SYSTEM === */
const PERKS_STORAGE_KEY = "customer_perks_v1";
const WALLETS_STORAGE_KEY = "customer_wallets_v1";

const DEFAULT_PERKS = [
  {
